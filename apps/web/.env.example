NEXT_PUBLIC_API_URL=https://shoptool.mn
NEXT_PUBLIC_SOCKET_URL=https://shoptool.mn

INTERNAL_VENDURE_SHOP_API=http://server:3000/shop-api
INTERNAL_VENDURE_ADMIN_API=http://server:3000/admin-api
INTERNAL_VENDURE_ASSETS=http://server:3000/assets/:path*
INTERNAL_VENDURE_MAILBOX=http://server:3000/mailbox/:path*

CLEANUP_SERVICE_URL=http://localhost:8500
GPU_SERVICE_URL=
CLEANUP_EDIT_TIMEOUT_MS=55000
SIMPLE_EDIT_TIMEOUT_MS=280000

STRAPI_API_TOKEN=
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=diy_products
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

STRICT_WEB_ENV=false
# Product studio image editing (required by /supplier/products/detect)
OPENAI_API_KEY=
# Optional; defaults to gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2
# Image edits may take longer than ordinary API calls.
OPENAI_EDIT_TIMEOUT_MS=180000

# Crowded product photos can take longer to detect.
GEMINI_DETECT_MODEL=gemini-3.1-flash-lite
GEMINI_DETECT_TIMEOUT_MS=120000
